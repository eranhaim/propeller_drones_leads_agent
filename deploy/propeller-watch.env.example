# Settings for the host-level outage alerter (deploy/propeller_watch.py).
#
# Install as /etc/propeller-watch.env, root-owned, mode 600. It holds the
# GreenAPI credentials, so it is never committed.
#
# These are deliberately a SEPARATE copy of the GreenAPI values, not a read
# of the bot's .env. The alerter exists to report that the bot is broken; a
# bad value in the bot's .env must not disarm it at the same moment.
#
# Known limitation: there is one GreenAPI instance, so the alerter sends over
# the same WhatsApp connection the bot uses. A total GreenAPI outage cannot
# be announced over WhatsApp. The cheapest second channel is a Telegram bot
# (free, one HTTPS POST, no shared dependency with GreenAPI) -- not built.

# Where to reach the bot's health endpoint on the host.
WATCH_HEALTH_URL=http://127.0.0.1:8084/health

# Who to alert. Local or international format both work.
WATCH_ALERT_PHONE=05XXXXXXXX

# The alerter's own GreenAPI credentials.
WATCH_GREEN_API_HOST=https://XXXX.api.greenapi.com
WATCH_GREEN_API_INSTANCE_ID=
WATCH_GREEN_API_TOKEN=

# Remembers the current reason so a persisting outage is not re-sent.
WATCH_STATE_FILE=/var/lib/propeller-watch/state.json
