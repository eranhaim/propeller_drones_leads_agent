# Copy to deploy.env and fill in. deploy.env is gitignored - it names the
# production host and points at a private key.
PROPELLER_HOST="ubuntu@your-server-ip"
PROPELLER_KEY="/path/to/your-key.pem"
# Optional, defaults to /home/ubuntu/propeller_drones_leads_agent
# PROPELLER_DIR="/home/ubuntu/propeller_drones_leads_agent"
