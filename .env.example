# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- GreenAPI (WhatsApp) ---
# Get these from https://console.green-api.com/
GREEN_API_INSTANCE_ID=1101000001
GREEN_API_TOKEN=d75b3a66374942c5b3c019c698abc2067e151558acbd412345
# Optional: override default base URL
GREEN_API_HOST=https://api.green-api.com
GREEN_API_MEDIA_HOST=https://media.green-api.com

# --- Database ---
# Inside docker-compose the host is "postgres". For local dev use "localhost".
DATABASE_URL=postgresql+psycopg2://propeller:propeller@postgres:5432/propeller_bot

# --- Chroma vector store ---
# Inside docker-compose the host is "chroma". For local dev use "localhost".
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=propeller_knowledge

# --- Website / knowledge sources ---
PROPELLER_WEBSITE_BASE=https://propeller-drones.com

# --- Sales handoff (LeadMe CRM) ---
# Never configure LeadMe's public supplier insert/update endpoints here.
# They upsert unmatched phones into campaign 12277 ("הוסרו מ-Whatsapp").
LEADME_INSERT_URL=
LEADME_UPDATE_URL=
LEADME_STATUS_ID=

# --- LeadMe official v3 API ---
# Keep the real key only in the protected production .env. Never commit it.
LEADME_API_KEY=
LEADME_V3_ENABLED=true

# --- LeadMe engagement levels (Level 1/2/3 statuses) ---
# Populate from this account's v3 getStatuses response. Names silently no-op.
# Level 1 = organic, website form, landing page, incoming call, returning
# lead, or our content plus a call booked for a specific window.
LEADME_STATUS_LEVEL_1=
# Level 2 = a meaningful WhatsApp reply, a booking without the content, or a
# stale version of either.
LEADME_STATUS_LEVEL_2=
# Level 3 = the starting point for paid advertising, and where a lead who
# never meaningfully replies stays.
LEADME_STATUS_LEVEL_3=

# --- Engagement classification rules (app/crm/levels.py) ---
# Where a lead came from is carried by its LeadMe TAGS, which the bot pulls
# itself (app/crm/leadme_source.py). Every tag rule below matches on
# CONTAINMENT, because the tags that matter are families rather than fixed
# labels. The values are the ones found on production tags on 2026-10-13.
#
# Paid advertising. Checked first and disqualifying for every Level 1 route:
# a Click-To-WhatsApp ad arrives with the same whatsapp source as a genuine
# organic lead, and these tags are the only thing separating them.
LEADME_PAID_TAGS=facebook,tiktok,instagram
LEADME_PAID_SOURCE_TYPES=facebook,tiktok,instagram
# A call to the number published on the website.
LEADME_INCOMING_CALL_TAGS=שיחה נכנסת
LEADME_INCOMING_CALL_SOURCE_TYPES=call
# The website form.
LEADME_WEBSITE_FORM_TAGS=אתר הבית
LEADME_WEBSITE_FORM_SOURCE_TYPES=form
# Landing pages, which the customer counts separately from the form.
LEADME_LANDING_PAGE_TAGS=עמוד נחיתה,דף נחיתה
LEADME_LANDING_PAGE_SOURCE_TYPES=lp
LEADME_LANDING_PAGE_CAMPAIGNS=
# The webinar: both a Level 1 source and a content signal.
LEADME_WEBINAR_TAGS=וובינר
LEADME_WEBINAR_CAMPAIGNS=פניות וובינר
# A genuine organic arrival. EMPTY ON PURPOSE. Setting this to "whatsapp"
# puts every untagged WhatsApp lead at Level 1, and a Click-To-WhatsApp ad
# whose Facebook tags have not landed yet is indistinguishable from an
# organic one -- which rebuilds the stale-Level-1 problem the customer
# complained about. Only fill it in once paid attribution is reliable.
LEADME_ORGANIC_SOURCE_TYPES=
# Legacy source and campaign labels. LeadMe has never sent this bot a source
# field, so these match nothing; kept for deployments that still set them.
LEADME_LEVEL_1_SOURCES=אורגני,organic,שיחה נכנסת,שיחת טלפון,טלפון,phone,phone call,incoming call
LEADME_LEVEL_1_CAMPAIGNS=
# How often to ask LeadMe where leads came from.
LEADME_SOURCE_INTERVAL_MINUTES=15
# Days a booking or a conversation keeps a lead at Level 1. Past this the
# lead falls back to Level 2.
LEAD_ENGAGEMENT_FRESH_DAYS=14
# Substantive inbound messages that count as having taken our content in,
# for a lead who got no video and no webinar. Still needs a booked window
# alongside it to reach Level 1.
LEAD_DEEP_ENGAGEMENT_MESSAGES=12
# Catalogue ids that count as "received the webinar". Empty because
# data/videos.json holds no webinar, so this content signal cannot fire.
# Add the webinar to the catalogue and name its id here to switch it on.
WEBINAR_VIDEO_IDS=

# How to write to LeadMe:
#   - "update-only" (default): only /supplier/update by phone. NEVER
#     inserts a new lead. Prevents duplicates landing in the wrong
#     campaign since LeadMe leads already exist from their own webhook.
#   - "insert-then-update": legacy behavior. Creates a new supplier lead
#     then updates its status. Set only if leads DON'T arrive via the
#     LeadMe webhook first.
#   - "never": no CRM writes at all.
LEADME_INSERT_MODE=update-only
# Value sent in the `tags` field on every lead push.
LEADME_SOURCE_LABEL=WhatsApp Bot

# --- LeadMe internal admin (for delete-lead from our /admin UI) ---
# LeadMe's public "supplier" API only supports insert+update, not delete.
# For manual QA (wipe a phone from LeadMe so re-submitting the form treats
# it as a new lead) we call LeadMe's internal admin endpoint using saved
# session cookies. Export cookies from a logged-in Chrome tab
# (DevTools -> Application -> Cookies) into this JSON file. Empty path
# => admin delete only wipes our local DB, LeadMe is left alone.
LEADME_COOKIES_PATH=data/leadme_cookies.json
LEADME_ADMIN_BASE=https://www.leadmecms.co.il

# --- Bot behavior ---
# Comma-separated list of phone numbers (digits only, no +) allowed to talk to
# the bot. Leave empty to allow anyone (production default).
ALLOWED_TEST_PHONES=

# --- Inbound webhook (LeadMe -> bot) ---
# LeadMe hits POST /webhook/leadme/{WEBHOOK_SECRET} when a new lead arrives.
# Only a new lead from an approved website-form source receives one immediate
# opener. This does not enable automated follow-ups or remarketing.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS origin shown only on the authenticated admin webhook page.
# Do not include /webhook/leadme or WEBHOOK_SECRET here.
WEBHOOK_PUBLIC_BASE_URL=https://propeller.64.176.175.97.nip.io
WEBSITE_FORM_OPENER_ENABLED=true
# Exact labels LeadMe must send in source / lead_source / origin for an
# immediate website-form opener. Incoming calls never receive one.
LEADME_WEBSITE_FORM_SOURCES=אתר הבית,דף נחיתה,homepage,landing page
# LeadMe's current website interface sends the campaign name instead of the
# source label. List only campaigns that are approved for this one opener.
LEADME_WEBSITE_FORM_CAMPAIGNS=מתעניינים אקדמיה
# Container-internal port uvicorn listens on. The docker-compose file maps
# host 127.0.0.1:${WEBHOOK_HOST_PORT:-8082} -> container 8080.
WEBHOOK_PORT=8080
# Override the host-side port if 8082 is taken on this machine.
WEBHOOK_HOST_PORT=8082

# --- Admin UI (browse lead conversations) ---
# Password-only signed-session login for /admin. If empty the admin UI refuses
# to serve anything (fail-closed). Use a strong random password -- this UI
# exposes every lead conversation.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# --- Follow-up nudges ---
# Legacy flag, kept false for compatibility. Nudges are gated by
# FOLLOWUP_NUDGES_ENABLED below, not by this value.
FOLLOWUP_ENABLED=false
# Master switch for proactive nudges to quiet leads. PAUSED by default
# (Omer, Sep 2026). The bot ALWAYS replies to inbound messages regardless of
# this flag; it only controls whether the scheduler proactively nudges leads
# who went silent. Set to true to resume nudges.
FOLLOWUP_NUDGES_ENABLED=false
# The remaining values apply only when FOLLOWUP_NUDGES_ENABLED=true.
# How often the scheduler wakes up to scan the DB (minutes). Keep this small
# vs. FOLLOWUP_FIRST_HOURS so we don't drift.
FOLLOWUP_INTERVAL_MINUTES=30
# Hours of silence before the FIRST nudge fires.
FOLLOWUP_FIRST_HOURS=24
# Additional hours after nudge #1 before the SECOND (and last) nudge fires.
FOLLOWUP_SECOND_HOURS=72
# Hard cap on nudges per lead. 2 is a good default; anything more feels spammy.
FOLLOWUP_MAX_NUDGES=2
# Polite window (Asia/Jerusalem local hour, 0-23). Nudges only send inside
# [start, end). 9-20 means: send between 09:00 and 19:59.
FOLLOWUP_QUIET_START_HOUR=9
FOLLOWUP_QUIET_END_HOUR=20

# Terminal status for a lead who opted out. 2392 is what the sales rep already
# uses for these leads by hand; confirm the id with getStatuses before changing
# it, and leave it blank rather than guessing -- a wrong id silently retires
# live leads.
LEADME_STATUS_NOT_RELEVANT=2392

# Maximum pending CRM pushes processed per scheduler tick.
LEADME_QUEUE_BATCH_SIZE=10

# Logging
LOG_LEVEL=INFO
