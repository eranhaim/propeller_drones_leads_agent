# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- GreenAPI (WhatsApp) ---
# Get these from https://console.green-api.com/
GREEN_API_INSTANCE_ID=1101000001
GREEN_API_TOKEN=d75b3a66374942c5b3c019c698abc2067e151558acbd412345
# Optional: override default base URL
GREEN_API_HOST=https://api.green-api.com
GREEN_API_MEDIA_HOST=https://media.green-api.com

# --- Database ---
# Inside docker-compose the host is "postgres". For local dev use "localhost".
DATABASE_URL=postgresql+psycopg2://propeller:propeller@postgres:5432/propeller_bot

# --- Chroma vector store ---
# Inside docker-compose the host is "chroma". For local dev use "localhost".
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=propeller_knowledge

# --- Website / knowledge sources ---
PROPELLER_WEBSITE_BASE=https://propeller-drones.com

# --- Sales handoff (LeadMe CRM) ---
# Never configure LeadMe's public supplier insert/update endpoints here.
# They upsert unmatched phones into campaign 12277 ("הוסרו מ-Whatsapp").
LEADME_INSERT_URL=
LEADME_UPDATE_URL=
LEADME_STATUS_ID=

# --- LeadMe engagement levels (Level 1/2/3 tags/statuses) ---
# Roy's LeadMe status mapping. Keep numeric IDs; names silently no-op.
# Level 1 = booked call or verified home-page / incoming-call / landing-page source.
LEADME_STATUS_LEVEL_1=7326
# Level 2 = replied to the bot but never booked.
LEADME_STATUS_LEVEL_2=7327
# Level 3 = new non-priority lead with no bot engagement yet.
LEADME_STATUS_LEVEL_3=7328

# How to write to LeadMe:
#   - "update-only" (default): only /supplier/update by phone. NEVER
#     inserts a new lead. Prevents duplicates landing in the wrong
#     campaign since LeadMe leads already exist from their own webhook.
#   - "insert-then-update": legacy behavior. Creates a new supplier lead
#     then updates its status. Set only if leads DON'T arrive via the
#     LeadMe webhook first.
#   - "never": no CRM writes at all.
LEADME_INSERT_MODE=update-only
# Value sent in the `tags` field on every lead push.
LEADME_SOURCE_LABEL=WhatsApp Bot

# --- LeadMe internal admin (for delete-lead from our /admin UI) ---
# LeadMe's public "supplier" API only supports insert+update, not delete.
# For manual QA (wipe a phone from LeadMe so re-submitting the form treats
# it as a new lead) we call LeadMe's internal admin endpoint using saved
# session cookies. Export cookies from a logged-in Chrome tab
# (DevTools -> Application -> Cookies) into this JSON file. Empty path
# => admin delete only wipes our local DB, LeadMe is left alone.
LEADME_COOKIES_PATH=data/leadme_cookies.json
LEADME_ADMIN_BASE=https://www.leadmecms.co.il

# --- Bot behavior ---
# Comma-separated list of phone numbers (digits only, no +) allowed to talk to
# the bot. Leave empty to allow anyone (production default).
ALLOWED_TEST_PHONES=

# --- Inbound webhook (LeadMe -> bot) ---
# LeadMe hits POST /webhook/leadme/{WEBHOOK_SECRET} when a new lead arrives.
# Only a new lead from an approved website-form source receives one immediate
# opener. This does not enable automated follow-ups or remarketing.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS origin shown only on the authenticated admin webhook page.
# Do not include /webhook/leadme or WEBHOOK_SECRET here.
WEBHOOK_PUBLIC_BASE_URL=https://propeller.64.176.175.97.nip.io
WEBSITE_FORM_OPENER_ENABLED=true
# Exact labels LeadMe must send in source / lead_source / origin for an
# immediate website-form opener. Incoming calls never receive one.
LEADME_WEBSITE_FORM_SOURCES=אתר הבית,דף נחיתה,homepage,landing page
# LeadMe's current website interface sends the campaign name instead of the
# source label. List only campaigns that are approved for this one opener.
LEADME_WEBSITE_FORM_CAMPAIGNS=מתעניינים אקדמיה
# Exact labels LeadMe must send in source / lead_source / origin for automatic
# Level 1 source qualification. Incoming calls are Level 1 but not openers.
LEADME_LEVEL_1_SOURCES=אתר הבית,שיחה נכנסת,דף נחיתה,homepage,incoming call,landing page
# Optional exact values from LeadMe's `tags` field meaning a call is already
# booked. Leave empty until Roy confirms the actual tag text; other tags stay
# stored but are never used to raise priority.
LEADME_BOOKED_CALL_TAGS=
# Container-internal port uvicorn listens on. The docker-compose file maps
# host 127.0.0.1:${WEBHOOK_HOST_PORT:-8082} -> container 8080.
WEBHOOK_PORT=8080
# Override the host-side port if 8082 is taken on this machine.
WEBHOOK_HOST_PORT=8082

# --- Admin UI (browse lead conversations) ---
# Password-only signed-session login for /admin. If empty the admin UI refuses
# to serve anything (fail-closed). Use a strong random password -- this UI
# exposes every lead conversation.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# --- Follow-up nudges (disabled by product policy) ---
# Scheduler-initiated WhatsApp messages (generic, video, and webinar) are
# hard-disabled in code. This legacy flag remains false for compatibility.
FOLLOWUP_ENABLED=false
# The remaining values apply only when FOLLOWUP_ENABLED=true.
# How many hours after the 55-min webinar before a follow-up is eligible.
WEBINAR_FOLLOWUP_HOURS=6
# How often the scheduler wakes up to scan the DB (minutes). Keep this small
# vs. FOLLOWUP_FIRST_HOURS so we don't drift.
FOLLOWUP_INTERVAL_MINUTES=30
# Hours of silence before the FIRST nudge fires.
FOLLOWUP_FIRST_HOURS=24
# Additional hours after nudge #1 before the SECOND (and last) nudge fires.
FOLLOWUP_SECOND_HOURS=72
# Hard cap on nudges per lead. 2 is a good default; anything more feels spammy.
FOLLOWUP_MAX_NUDGES=2
# Polite window (Asia/Jerusalem local hour, 0-23). Nudges only send inside
# [start, end). 9-20 means: send between 09:00 and 19:59.
FOLLOWUP_QUIET_START_HOUR=9
FOLLOWUP_QUIET_END_HOUR=20

# Existing "לא רלוונטי" status in the Propeller LeadMe account. Use a
# different configured relationship ID only if LeadMe changes this status.
LEADME_STATUS_NOT_RELEVANT=2392

# Logging
LOG_LEVEL=INFO
